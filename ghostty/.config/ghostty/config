background = #1a1b26
foreground = #c0caf5
selection-background = #33467c
selection-foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #1a1b26
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
background-opacity = 0.85

working-directory = ~/dev
command = /opt/homebrew/bin/tmux new-session

keybind = super+enter=unbind

# Send private escape sequences for tmux Hyper-[ / Hyper-], Hyper-z / Hyper-x,
# Hyper-1 / Hyper-2, and Hyper-Up / Hyper-Down
keybind = super+ctrl+alt+shift+[=text:\x1b[5;30012~
keybind = super+ctrl+alt+shift+]=text:\x1b[5;30013~
keybind = super+ctrl+alt+shift+z=text:\x1b[5;30014~
keybind = super+ctrl+alt+shift+x=text:\x1b[5;30015~
keybind = super+ctrl+alt+shift+1=text:\x1b[5;30016~
keybind = super+ctrl+alt+shift+2=text:\x1b[5;30017~
keybind = super+ctrl+alt+shift+up=text:\x1b[5;30018~
keybind = super+ctrl+alt+shift+down=text:\x1b[5;30019~
