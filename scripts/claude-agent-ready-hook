#!/usr/bin/env python3
"""Claude Code hook adapter for dotfiles agent-ready markers."""

import json
import os
import subprocess
import sys
from pathlib import Path

DOTFILES_AGENT_READY = Path.home() / "dev" / "dotfiles" / "scripts" / "agent-ready"

SET_EVENTS = {"Stop", "SubagentStop", "Notification"}
CLEAR_EVENTS = {"UserPromptSubmit", "PreToolUse", "SessionEnd"}


def hook_event(payload: dict) -> str:
    for key in ("hook_event_name", "event", "type", "name"):
        value = payload.get(key)
        if isinstance(value, str):
            return value
    return ""


def run_agent_ready(action: str) -> int:
    if not os.environ.get("TMUX_PANE"):
        return 0
    command = [str(DOTFILES_AGENT_READY), action, "--source", "claude"] if action == "set" else [str(DOTFILES_AGENT_READY), action]
    return subprocess.run(command).returncode


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        payload = {}
    event = hook_event(payload)
    if event in SET_EVENTS:
        return run_agent_ready("set")
    if event in CLEAR_EVENTS:
        return run_agent_ready("clear")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
