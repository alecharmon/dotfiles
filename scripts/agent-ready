#!/usr/bin/env python3
"""Generic tmux-pane readiness marker for terminal agents."""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional


def marker_dir() -> Path:
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")).expanduser()
    return cache_home / "dotfiles" / "agent-ready"


def normalize_pane(pane: Optional[str]) -> Optional[str]:
    pane = pane or os.environ.get("TMUX_PANE")
    if not pane:
        return None
    return pane if pane.startswith("%") else f"%{pane}"


def marker_path(pane: str) -> Path:
    return marker_dir() / f"{pane.lstrip('%')}.json"


def write_marker(args: argparse.Namespace) -> int:
    pane = normalize_pane(args.pane)
    if not pane:
        return 0
    marker_dir().mkdir(parents=True, exist_ok=True)
    data = {
        "pane": pane,
        "source": args.source,
        "state": "ready",
        "message": args.message,
        "updatedAt": int(time.time()),
    }
    marker_path(pane).write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    return 0


def clear_marker(args: argparse.Namespace) -> int:
    pane = normalize_pane(args.pane)
    if not pane:
        return 0
    marker_path(pane).unlink(missing_ok=True)
    return 0


def read_markers() -> list[dict]:
    root = marker_dir()
    if not root.exists():
        return []
    markers = []
    for path in sorted(root.glob("*.json")):
        try:
            markers.append(json.loads(path.read_text()))
        except (OSError, json.JSONDecodeError):
            continue
    return markers


def list_markers(_args: argparse.Namespace) -> int:
    for marker in read_markers():
        print(f"{marker.get('pane', '')}\t{marker.get('source', '')}\t{marker.get('message', '')}")
    return 0


def current_tmux_panes() -> set[str]:
    if not shutil.which("tmux"):
        return set()
    try:
        out = subprocess.run(
            ["tmux", "list-panes", "-a", "-F", "#{pane_id}"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout
    except subprocess.CalledProcessError:
        return set()
    return {line.strip() for line in out.splitlines() if line.strip()}


def prune_markers(_args: argparse.Namespace) -> int:
    live_panes = current_tmux_panes()
    if not live_panes:
        return 0
    for marker in read_markers():
        pane = marker.get("pane")
        if pane and pane not in live_panes:
            marker_path(pane).unlink(missing_ok=True)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Manage tmux-pane agent readiness markers")
    subcommands = parser.add_subparsers(dest="command", required=True)

    set_parser = subcommands.add_parser("set", help="mark a pane as ready for input")
    set_parser.add_argument("--pane", help="tmux pane id; defaults to TMUX_PANE")
    set_parser.add_argument("--source", default="manual", help="marker source, e.g. pi or claude")
    set_parser.add_argument("--message", default="waiting for input", help="human-readable marker message")
    set_parser.set_defaults(func=write_marker)

    clear_parser = subcommands.add_parser("clear", help="clear a pane readiness marker")
    clear_parser.add_argument("--pane", help="tmux pane id; defaults to TMUX_PANE")
    clear_parser.set_defaults(func=clear_marker)

    list_parser = subcommands.add_parser("list", help="list readiness markers")
    list_parser.set_defaults(func=list_markers)

    prune_parser = subcommands.add_parser("prune", help="remove markers for panes no longer in tmux")
    prune_parser.set_defaults(func=prune_markers)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
