#!/usr/bin/env python3
"""
tmux-tabs — vertical window sidebar for tmux.

Shows all tmux windows in a narrow left pane with bell highlights and terminal
titles. Click any window to switch to it. Automatically follows focus when a
new window is opened (e.g. via F2 in byobu).

Usage:
  Launch in a 15%-wide left split:
    tmux split-window -hb -p 15 tmux-tabs

  Recommended: bind to a key in ~/.tmux.conf:
    bind -n F9 split-window -hb -p 15 tmux-tabs

  Quit: press q inside the sidebar.

Requirements:
  pip install --user textual   (python3.12)

Colors are read live from the tmux theme (window-status-style, etc.) so the
sidebar matches your current byobu/tmux color scheme automatically.
"""

import asyncio
import hashlib
import json
import os
import shutil
import subprocess
import sys
from difflib import SequenceMatcher
from pathlib import Path
from textual.app import App, ComposeResult
from textual.containers import Vertical
from textual.reactive import reactive
from textual.widgets import Label


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True, check=True).stdout.strip()


def run(*args, timeout=None):
    return subprocess.run(args, capture_output=True, text=True, check=True, timeout=timeout).stdout.strip()


def pane_var(pane, fmt):
    return tmux("display-message", "-p", "-t", pane, fmt)


def project_group(path):
    dev_dir = os.path.expanduser("~/dev")
    path = os.path.abspath(os.path.expanduser(path or ""))
    try:
        rel = os.path.relpath(path, dev_dir)
    except ValueError:
        return "Other"
    if rel == ".":
        return "dev"
    if rel.startswith(".."):
        return "Other"
    parts = rel.split(os.sep)
    if parts[0] == "flora" and len(parts) > 1 and parts[1]:
        return parts[1]
    return parts[0] or "Other"


def grouped_windows(windows):
    groups = {}
    for window in windows:
        groups.setdefault(window["group"], []).append(window)
    ordered_names = sorted((name for name in groups if name != "Other"), key=str.casefold)
    if "Other" in groups:
        ordered_names.append("Other")
    return [(name, groups[name]) for name in ordered_names]


def sidebar_width(windows, window_width):
    content_width = 18
    for group, group_windows in grouped_windows(windows):
        content_width = max(content_width, len(group) + 2)
        for window in group_windows:
            title = window.get("title", "").lstrip("✳").strip()
            description = window.get("description", "")
            content_width = max(content_width, len(window.get("name", "")) + 4)
            if title:
                content_width = max(content_width, len(title) + 6)
            if description:
                content_width = max(content_width, len(description) + 6)
    max_width = min(48, max(18, window_width // 4))
    return max(18, min(content_width, max_width))


def pane_records(win_index):
    out = tmux(
        "list-panes", "-t", win_index, "-F",
        "#{pane_id}|#{pane_left}|#{pane_top}|#{pane_active}|#{pane_current_command}|#{pane_title}|#{pane_current_path}",
    )
    panes = []
    for line in out.splitlines():
        pane_id, left, top, active, command, title, path = line.split("|", 6)
        panes.append({
            "id": pane_id, "left": int(left), "top": int(top), "active": active == "1",
            "command": command, "title": title, "path": path,
        })
    return panes


def is_sidebar_pane(pane):
    return pane.get("title") == "tmux-tabs" or pane.get("command") == "Python" and pane.get("path") == os.path.expanduser("~/dev")


def content_panes(panes):
    return [pane for pane in panes if not is_sidebar_pane(pane)] or panes


def representative_pane(panes):
    candidates = content_panes(panes)
    return next((pane for pane in candidates if pane.get("active")), candidates[0] if candidates else {})


def window_display_name(tmux_name, pane):
    if not pane:
        return tmux_name
    if pane.get("command") == "Python" or tmux_name.endswith(":Python"):
        path_name = os.path.basename(pane.get("path") or "") or tmux_name.split(":", 1)[0]
        return f"{path_name}:{pane.get('command', '').strip() or 'pane'}"
    return tmux_name


def leftmost_active_pane(win_index):
    panes = content_panes(pane_records(win_index))
    panes.sort(key=lambda pane: (pane["left"], pane["top"]))
    return panes[0]["id"] if panes else ""


def active_pane(win_index):
    pane = representative_pane(pane_records(win_index))
    return pane.get("id", "")


def agent_ready_dir():
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")).expanduser()
    return cache_home / "dotfiles" / "agent-ready"


def pane_ids_by_window():
    out = tmux("list-panes", "-s", "-F", "#{window_index}|#{pane_id}|#{pane_current_command}|#{pane_title}|#{pane_current_path}")
    panes = {}
    for line in out.splitlines():
        win_index, pane_id, command, title, path = line.split("|", 4)
        pane = {"id": pane_id, "command": command, "title": title, "path": path}
        if not is_sidebar_pane(pane):
            panes.setdefault(win_index, []).append(pane_id)
    return panes


def live_pane_ids():
    return {pane for panes in pane_ids_by_window().values() for pane in panes}


def ready_panes(live_panes=None):
    live_panes = live_panes or live_pane_ids()
    root = agent_ready_dir()
    if not root.exists():
        return set()
    ready = set()
    for marker in root.glob("*.json"):
        try:
            data = json.loads(marker.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        pane = data.get("pane")
        if pane in live_panes:
            ready.add(pane)
        elif pane:
            marker.unlink(missing_ok=True)
    return ready


def ready_window_indexes(window_panes, ready):
    return {win_index for win_index, panes in window_panes.items() if any(pane in ready for pane in panes)}


def clear_ready_panes(panes):
    for pane in panes:
        (agent_ready_dir() / f"{pane.lstrip('%')}.json").unlink(missing_ok=True)


def descriptions_dir():
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")).expanduser()
    session_id = tmux("display-message", "-p", "#{session_id}").lstrip("$")
    return cache_home / "dotfiles" / "tmux-tabs" / "descriptions" / session_id


def description_cache_name(session_id, window_index):
    return f"{session_id.lstrip('$')}-{window_index}.json"


def normalize_capture(text):
    return "\n".join(line.rstrip() for line in text.splitlines() if line.strip())[-12000:]


def content_signature(text):
    return hashlib.sha256(normalize_capture(text).encode()).hexdigest()


def content_changed_significantly(old_text, new_text):
    old_norm, new_norm = normalize_capture(old_text), normalize_capture(new_text)
    if not old_norm and new_norm:
        return True
    if not new_norm or old_norm == new_norm:
        return False
    return SequenceMatcher(None, old_norm[-4000:], new_norm[-4000:]).ratio() < 0.85


def description_prompt(captured_text):
    return (
        "Write one concise description, at most 12 words, of what this terminal session is currently doing. "
        "Do not include secrets, keys, tokens, or private data. Output only the description.\n\n"
        f"Terminal content:\n{normalize_capture(captured_text)[-8000:]}"
    )


def description_for_window(win_index):
    path = descriptions_dir() / description_cache_name(tmux("display-message", "-p", "#{session_id}"), win_index)
    try:
        return json.loads(path.read_text()).get("description", "")
    except (OSError, json.JSONDecodeError):
        return ""


def write_description(win_index, captured_text, description):
    root = descriptions_dir()
    root.mkdir(parents=True, exist_ok=True)
    session_id = tmux("display-message", "-p", "#{session_id}")
    path = root / description_cache_name(session_id, win_index)
    data = {
        "window": win_index,
        "signature": content_signature(captured_text),
        "sample": normalize_capture(captured_text)[-4000:],
        "description": description.strip().splitlines()[0][:120],
    }
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")


def cached_description_record(win_index):
    path = descriptions_dir() / description_cache_name(tmux("display-message", "-p", "#{session_id}"), win_index)
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def capture_window_text(win_index):
    pane = active_pane(win_index)
    if pane_var(pane, "#{pane_title}") == "tmux-tabs":
        return ""
    return tmux("capture-pane", "-p", "-t", pane, "-S", "-200")


def clean_description_output(output):
    for line in output.splitlines():
        line = line.strip()
        if not line or line.startswith("\x1b") or line.startswith("╭") or line.startswith("│") or line.startswith("╰"):
            continue
        return line[:120]
    return ""


def describe_with_pi(captured_text):
    if not shutil.which("llm-redactor-exec") or not shutil.which("pi"):
        return ""
    try:
        output = run(
            "llm-redactor-exec", "--",
            "pi", "-p", "--no-session", "--model", "openai-codex/gpt-5.3-codex-spark",
            description_prompt(captured_text),
            timeout=45,
        )
        return clean_description_output(output)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return ""


def tmux_windows():
    window_panes = pane_ids_by_window()
    ready_windows = ready_window_indexes(window_panes, ready_panes({pane for panes in window_panes.values() for pane in panes}))
    out = tmux("list-windows", "-F",
               "#{window_index}|#{window_name}|#{window_bell_flag}|#{window_flags}|#{pane_title}|#{pane_current_path}")
    windows = []
    for line in out.splitlines():
        idx, name, bell, flags, title, path = line.split("|", 5)
        pane = representative_pane(pane_records(idx))
        display_path = pane.get("path") or path
        display_title = pane.get("title") or title
        windows.append({
            "index": idx, "name": window_display_name(name, pane), "bell": bell == "1",
            "ready": bell == "1" or idx in ready_windows,
            "active": "*" in flags, "last": "-" in flags, "title": display_title,
            "path": display_path, "group": project_group(display_path), "panes": window_panes.get(idx, []),
            "description": description_for_window(idx),
        })
    return windows


def parse_style(style):
    return {k: v or True for k, _, v in (p.strip().partition("=") for p in style.split(","))}


def tmux_styles():
    keys = {"normal": "window-status-style", "current": "window-status-current-style",
            "bell": "window-status-bell-style", "status": "status-style"}
    return {name: parse_style(tmux("show-options", "-gv", key)) for name, key in keys.items()}


def style_to_css(s, base=None):
    bg = s.get("bg", base.get("bg", "default") if base else "default")
    fg = s.get("fg", base.get("fg", "default") if base else "default")
    if s.get("reverse"):
        bg, fg = fg, bg
    bold = "\n        text-style: bold;" if s.get("bold") else ""
    return f"background: {bg};\n        color: {fg};{bold}"


def toggle_sidebar():
    panes = tmux("list-panes", "-a", "-F", "#{session_id}|#{pane_id}|#{pane_title}")
    current_session = tmux("display-message", "-p", "#{session_id}")
    for line in panes.splitlines():
        session_id, pane_id, pane_title = line.split("|", 2)
        if session_id == current_session and pane_title == "tmux-tabs":
            tmux("kill-pane", "-t", pane_id)
            return

    windows = tmux_windows()
    current_width = int(tmux("display-message", "-p", "#{window_width}"))
    width = sidebar_width(windows, current_width)
    target_pane = leftmost_active_pane(tmux("display-message", "-p", "#{window_index}"))
    tmux("split-window", "-h", "-l", str(width), "-t", target_pane, "-b", f"{__file__} --sidebar")


ICON_READY = "🔔 "   # emoji is two cells in most terminals
ICON_EMPTY = "   "
DETAIL_INDENT = "   "
DESCRIPTION_MAX = 42


def clipped_description(description):
    description = description.strip()
    if len(description) <= DESCRIPTION_MAX:
        return description
    return description[:DESCRIPTION_MAX - 1].rstrip() + "…"


def window_icon(win):
    if win.get("ready"):
        return ICON_READY
    return ICON_EMPTY


def window_label(win):
    title = win.get("title", "").lstrip("✳").strip()
    description = clipped_description(win.get("description", ""))
    lines = [f"{window_icon(win)}[b]{win['name']}[/b]"]
    if title:
        lines.append(f"{DETAIL_INDENT}[dim]{title}[/dim]")
    if description:
        lines.append(f"{DETAIL_INDENT}[dim]{description}[/dim]")
    return "\n".join(lines)


class GroupHeader(Label):
    def __init__(self, name):
        super().__init__(name, classes="group")


class WindowItem(Label):
    def __init__(self, win, app_ref):
        self.win_index = win["index"]
        self._app_ref = app_ref
        classes = "window" + (" bell" if win["bell"] else "") + (" active" if win["active"] else "")
        super().__init__(window_label(win), classes=classes, markup=True)

    def on_click(self):
        self._app_ref.switch_to(self.win_index)


class TmuxTabs(App):
    DEFAULT_CSS = ""
    BINDINGS = [("q", "quit", "Quit")]
    windows: reactive[list] = reactive([], recompose=True)
    _pane_id: str = ""
    _current_window: str = ""
    _fifo_path: str = ""
    _fifo_fd: int = 0
    _description_refresh_running: bool = False

    @classmethod
    def build_css(cls):
        s = tmux_styles()
        base = s["status"]
        bg = s["normal"].get("bg", base.get("bg", "#94cdba"))
        fg = s["normal"].get("fg", base.get("fg", "black"))
        normal = style_to_css(s["normal"], base)
        bell = style_to_css(s["bell"], base)
        current_style = s["current"]
        if "bg" not in current_style and "fg" not in current_style:
            current_style = {"bg": "#292e42", "fg": "#e0af68", "bold": True}
        current = style_to_css(current_style, base)
        return f"""
    * {{ scrollbar-background: {bg}; scrollbar-color: {fg}; scrollbar-size: 0 0; }}
    Screen {{ background: {bg}; color: {fg}; layers: base; }}
    #windows {{ height: 1fr; padding-top: 1; overflow-y: auto; background: {bg}; align: left top; }}
    .group {{ margin-top: 2; padding: 0 1; height: 1; width: 100%; background: {bg}; color: {fg}; text-style: bold; }}
    .window {{ margin-bottom: 1; padding: 0 1; height: auto; width: 100%; {normal} }}
    .window .dim {{ color: {fg}; text-style: dim; }}
    .bell {{ {bell} }}
    .active {{ {current} }}
    .active .dim {{ color: {fg}; text-style: dim; }}
    """

    def compose(self) -> ComposeResult:
        children = []
        for group, windows in grouped_windows(self.windows):
            children.append(GroupHeader(group))
            children.extend(WindowItem(window, self) for window in windows)
        yield Vertical(*children, id="windows")

    def on_mount(self):
        self._pane_id = os.environ["TMUX_PANE"]
        self._current_window = pane_var(self._pane_id, "#{window_index}")
        tmux("select-pane", "-t", self._pane_id, "-T", "tmux-tabs")
        self.windows = tmux_windows()
        self._setup_fifo()
        self.set_timer(1.0, self.schedule_description_refresh)
        self.set_interval(60.0, self.schedule_description_refresh)
        self.set_interval(1.0, self.refresh_windows)

    def _setup_fifo(self):
        # session_id is like "$1"; strip the $ so it can't be shell-expanded inside the hook
        session_id = pane_var(self._pane_id, "#{session_id}").lstrip("$")
        self._fifo_path = f"/tmp/tmux-tabs-{session_id}"
        if os.path.exists(self._fifo_path):
            os.unlink(self._fifo_path)
        os.mkfifo(self._fifo_path)
        # On window switch or creation, tmux writes the relevant window index to the FIFO.
        # window-linked covers new windows, which don't fire after-select-window.
        hook = f"run-shell -b 'echo #{{window_index}} >> {self._fifo_path}'"
        tmux("set-hook", "-g", "after-select-window", hook)
        tmux("set-hook", "-g", "window-linked", hook)
        self._fifo_fd = os.open(self._fifo_path, os.O_RDONLY | os.O_NONBLOCK)
        asyncio.get_event_loop().add_reader(self._fifo_fd, self._on_window_switched)

    def _on_window_switched(self):
        # A hook fired (select or new window). Follow the actually-active window, not the
        # hook's index: a backgrounded new-window reports its index without becoming active.
        os.read(self._fifo_fd, 4096)
        active = tmux("display-message", "-p", "#{window_index}")
        if active != self._current_window:
            self.switch_to(active)
            self.refresh_windows()

    def on_app_focus(self):
        # Gained focus means the user's pane was closed; move sidebar to another window
        self.windows = tmux_windows()
        if pane_var(self._pane_id, "#{window_panes}") == "1":
            target = (next((w["index"] for w in self.windows if w.get("last")), None)
                      or next((w["index"] for w in self.windows if not w["active"]), None))
            if target:
                self.switch_to(target)

    def refresh_windows(self):
        self.windows = tmux_windows()

    def schedule_description_refresh(self):
        if self._description_refresh_running:
            return
        self._description_refresh_running = True
        asyncio.create_task(self.refresh_descriptions())

    async def refresh_descriptions(self):
        try:
            for window in tmux_windows():
                try:
                    captured = await asyncio.to_thread(capture_window_text, window["index"])
                    if not captured.strip():
                        continue
                    record = cached_description_record(window["index"])
                    if record.get("signature") == content_signature(captured):
                        continue
                    if record and not content_changed_significantly(record.get("sample", ""), captured):
                        continue
                    description = await asyncio.to_thread(describe_with_pi, captured)
                    if description:
                        write_description(window["index"], captured, description)
                except Exception:
                    continue
            self.refresh_windows()
        finally:
            self._description_refresh_running = False

    def switch_to(self, win_index):
        # Move the sidebar to the left edge of the target window and keep it visible.
        target_pane = leftmost_active_pane(win_index)
        focus_pane = active_pane(win_index)
        target_width = int(pane_var(target_pane, "#{window_width}"))
        width = sidebar_width(self.windows, target_width)
        tmux("move-pane", "-h", "-l", str(width), "-s", self._pane_id, "-t", target_pane, "-d", "-b")
        tmux("select-window", "-t", win_index)
        tmux("select-pane", "-t", focus_pane)
        clear_ready_panes(next((w.get("panes", []) for w in self.windows if w["index"] == win_index), []))
        self._current_window = win_index


if __name__ == "__main__":
    if "--sidebar" in sys.argv:
        os.environ.setdefault("TEXTUAL_THEME", "")
        TmuxTabs.CSS = TmuxTabs.build_css()
        TmuxTabs().run(inline=False)
    else:
        toggle_sidebar()
