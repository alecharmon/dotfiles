#!/usr/bin/env bash
# tmux-tabs — vertical window sidebar for tmux.
#
# This is a thin launcher for the Rust implementation under ../tmux-tabs. It
# builds the release binary on first use, then execs it, forwarding all args:
#
#   tmux-tabs                 toggle the sidebar
#   tmux-tabs --sidebar       run the sidebar TUI (used internally by the split)
#   tmux-tabs --select prev   move the sidebar to the previous grouped window
#   tmux-tabs --select next   move the sidebar to the next grouped window
#
# Mouse clicks and wheel scrolling are supported inside the sidebar. Press q to
# quit. See ../tmux-tabs/README.md for details.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CRATE_DIR="$DOTFILES_DIR/tmux-tabs"
BIN="$CRATE_DIR/target/release/tmux-tabs"

if [ ! -x "$BIN" ]; then
    if command -v cargo >/dev/null 2>&1; then
        cargo build --release --manifest-path "$CRATE_DIR/Cargo.toml" >&2
    else
        echo "tmux-tabs: cargo not found; cannot build the Rust sidebar. Install Rust (https://rustup.rs)." >&2
        exit 1
    fi
fi

exec "$BIN" "$@"
