#!/usr/bin/env python3
"""Cache the open GitHub PR for a tmux pane/repo path."""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional


def marker_dir() -> Path:
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")).expanduser()
    return cache_home / "dotfiles" / "pr-status"


def normalize_pane(pane: Optional[str]) -> Optional[str]:
    pane = pane or os.environ.get("TMUX_PANE")
    if not pane:
        return None
    return pane if pane.startswith("%") else f"%{pane}"


def marker_path(pane: str) -> Path:
    return marker_dir() / f"{pane.lstrip('%')}.json"


def remove_marker(pane: str) -> None:
    marker_path(pane).unlink(missing_ok=True)


def refresh(args: argparse.Namespace) -> int:
    pane = normalize_pane(args.pane)
    if not pane:
        return 0

    repo_path = Path(args.path).expanduser()
    if not repo_path.exists():
        remove_marker(pane)
        return 0

    try:
        proc = subprocess.run(
            ["gh", "pr", "view", "--json", "number,title,url,isDraft"],
            cwd=repo_path,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        remove_marker(pane)
        return 0

    if proc.returncode != 0:
        remove_marker(pane)
        return 0

    try:
        gh_data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        remove_marker(pane)
        return 0

    url = gh_data.get("url") or ""
    if not url:
        remove_marker(pane)
        return 0

    marker_dir().mkdir(parents=True, exist_ok=True)
    data = {
        "pane": pane,
        "path": str(repo_path),
        "number": int(gh_data.get("number") or 0),
        "title": gh_data.get("title") or "",
        "url": url,
        "draft": bool(gh_data.get("isDraft")),
        "updatedAt": int(time.time()),
    }
    marker_path(pane).write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Cache PR status for tmux-tabs")
    subcommands = parser.add_subparsers(dest="command", required=True)

    refresh_parser = subcommands.add_parser("refresh", help="refresh PR status for a pane/path")
    refresh_parser.add_argument("--pane", help="tmux pane id; defaults to TMUX_PANE")
    refresh_parser.add_argument("--path", default=os.getcwd(), help="repo path to inspect")
    refresh_parser.set_defaults(func=refresh)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
